---
// Un carosello vero dentro un telefono: si sfoglia con il dito, con le frecce o con la tastiera.
import Immagine from './Immagine.astro';
import Icona from './Icona.astro';
import Collegamento from './Collegamento.astro';
import { dimensioni } from '../lib/media.js';
const { serie, ui, id } = Astro.props;
const { w, h } = dimensioni(serie.slide[0].src);
---
<figure class="carosello" data-carosello>
  <div class="carosello-sinistra">
  <div class="carosello-telefono" style={`--rapporto:${w}/${h}`}>
    <div class="carosello-nastro" data-nastro tabindex="0" role="group" aria-roledescription="carosello" aria-label={serie.nome} id={id}>
      {serie.slide.map((s, i) => (
        <div class="carosello-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${serie.slide.length}`}>
          <Immagine img={s} sizes="(max-width: 767px) 80vw, 340px" cornice="nessuna" />
        </div>
      ))}
    </div>
  </div>
  <figcaption class="carosello-comandi">
    <button type="button" class="carosello-freccia" data-indietro aria-controls={id} aria-label={ui.precedente}><Icona nome="sinistra" /></button>
    <span class="carosello-pallini">
      {serie.slide.map((_, i) => <button type="button" data-pallino aria-controls={id} aria-label={`${i + 1} / ${serie.slide.length}`}></button>)}
    </span>
    <button type="button" class="carosello-freccia" data-avanti aria-controls={id} aria-label={ui.successiva}><Icona nome="destra" /></button>
  </figcaption>
  </div>
  <div class="carosello-destra">
    <p class="hud muted carosello-nome">{serie.nome}</p>
    {serie.crediti && (
      <p class="carosello-crediti">{serie.crediti.nota} {serie.crediti.voci.map((c, i) => <>{i > 0 && ' · '}<Collegamento href={c.link}>{c.etichetta}</Collegamento></>)}</p>
    )}
  </div>
</figure>
<style is:global>
  .carosello, .carosello-sinistra, .carosello-destra { display: flex; flex-direction: column; align-items: center; gap: var(--s-4); }
  .carosello-telefono { width: min(calc(100% - 22px), 300px); padding: 56px 11px 64px; border-radius: var(--raggio-telefono); background: var(--telefono); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .12), 0 0 0 1px rgba(0, 0, 0, .35), 0 24px 50px var(--ombra-carta); box-sizing: content-box; position: relative; }
  .carosello-telefono::before { content: ''; position: absolute; top: 20px; left: 50%; width: 86px; height: 22px; border-radius: 12px; background: #000; transform: translateX(-50%); }
  .carosello-nastro { display: flex; aspect-ratio: var(--rapporto); overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; background: #000; border-radius: 4px; }
  .carosello-nastro::-webkit-scrollbar { display: none; }
  .carosello-nastro:focus-visible { outline-offset: 4px; }
  .carosello-slide { flex: 0 0 100%; scroll-snap-align: start; }
  .carosello-slide .immagine, .carosello-slide img { width: 100%; height: 100%; }
  .carosello-comandi { display: flex; align-items: center; gap: var(--s-3); }
  .carosello-freccia { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--line-strong); color: var(--ink); transition: background-color var(--rapido) linear, color var(--rapido) linear; }
  @media (hover: hover) { .carosello-freccia:hover:not(:disabled) { background: var(--invert-bg); color: var(--invert-fg); } }
  .carosello-freccia:disabled { opacity: .35; cursor: default; }
  .carosello-freccia svg { width: 16px; height: 16px; }
  .carosello-pallini { display: flex; gap: 2px; }
  .carosello-pallini button { width: 24px; height: 24px; display: grid; place-items: center; }
  .carosello-pallini button::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--line-strong); transition: background-color .2s; }
  .carosello-pallini button[aria-current]::before { background: var(--accent-ink); }
  .carosello-nome { text-align: center; }
  .carosello-crediti { max-width: 30rem; font-size: .75rem; line-height: 1.6; color: var(--faint); text-align: center; }
  /* un carosello solo, su schermi larghi: telefono a sinistra, nome e crediti a destra */
  @media (min-width: 1100px) {
    .caroselli:not(.griglia-3) .carosello { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: var(--s-8); }
    .caroselli:not(.griglia-3) .carosello-telefono { width: 340px; }
    .caroselli:not(.griglia-3) .carosello-destra { align-items: flex-start; max-width: 30rem; }
    .caroselli:not(.griglia-3) .carosello-nome, .caroselli:not(.griglia-3) .carosello-crediti { text-align: left; }
    .caroselli:not(.griglia-3) .carosello-crediti { font-size: .875rem; }
  }
  .carosello-crediti a { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 2px; }
</style>
