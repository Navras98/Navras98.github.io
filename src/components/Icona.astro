---
// Icone di interfaccia (tratto 2px) e marchi social (tracciati in src/lib/marchi.json).
import marchi from '../lib/marchi.json';
const { nome, class: classe } = Astro.props;
const tratti = {
  freccia: '<path d="M7 17 17 7M7 7h10v10"/>',
  destra: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  sinistra: '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  giu: '<path d="m6 9 6 6 6-6"/>',
  sole: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  luna: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  chiudi: '<path d="M6 6l12 12M18 6 6 18"/>',
  posta: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/>',
  copia: '<rect x="9" y="9" width="12" height="12" rx="1"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/>',
  invia: '<path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/>',
  piu: '<path d="M12 5v14M5 12h14"/>',
  spunta: '<path d="m5 12 5 5L20 7"/>',
  notizie: '<path d="M4 5h13v14H6a2 2 0 0 1-2-2z"/><path d="M17 9h3v8a2 2 0 0 1-2 2"/><path d="M8 9h5M8 13h5M8 17h3"/>',
  testo: '<path d="M4 6h16M4 12h16M4 18h10"/>',
  immagine: '<rect x="3" y="4" width="18" height="16" rx="1"/><circle cx="9" cy="10" r="2"/><path d="m21 17-5-5-9 8"/>',
  archivio: '<rect x="3" y="4" width="18" height="5"/><path d="M5 9v11h14V9M10 13h4"/>',
  casa: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  progetti: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>',
  newsletter: '<path d="M4 4h16v16H4z"/><path d="M8 9h8M8 13h8M8 17h5"/>',
  mano: '<path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12M11 11.5V4.5a1.5 1.5 0 0 1 3 0V12M14 11.5V6.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L3.3 15a1.5 1.5 0 0 1 2.4-1.8L8 15.5"/>',
};
const social = marchi.social ?? marchi;
const chiave = String(nome ?? '').toLowerCase();
const d = social[chiave];
---
{d
  ? <svg class={classe} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d={d} /></svg>
  : <svg class={classe} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={tratti[chiave]} />}
