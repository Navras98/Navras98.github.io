---
import Base from '../layouts/Base.astro';
import Immagine from '../components/Immagine.astro';
import Icona from '../components/Icona.astro';
import Sezione from '../components/Sezione.astro';
import CarteCanale from '../components/CarteCanale.astro';
import Bottone from '../components/Bottone.astro';
import { pagina, titolo } from '../lib/contenuti.js';
const c = await pagina('contatti');
const imp = await pagina('impostazioni');
const m = c.modulo;
const chiave = imp.chiave_modulo.trim();
const indice = [{ id: 'hero', etichetta: c.apertura.etichetta }, { id: 'scrivi', etichetta: c.scrivimi.etichetta }, { id: 'canali', etichetta: c.altri_canali.etichetta }];
---
<Base seo={c.seo} invito={false} indice={indice}>
  <section class="sezione" id="hero" aria-labelledby="titolo-pagina">
    <div class="contenitore">
      <div class="contatti-apertura">
        <div class="contatti-testa">
          <p class="hud muted entra">{c.apertura.etichetta}</p>
          <h1 class="titolo-pagina entra" id="titolo-pagina" style="--e:1" set:html={titolo(c.apertura.titolo)} />
          <p class="testo-grande entra" style="--e:2">{c.apertura.testo}</p>
        </div>
        <div class="contatti-foto entra" style="--e:2">
          <span class="tacca-foto as" aria-hidden="true"></span><span class="tacca-foto ad" aria-hidden="true"></span>
          <Immagine img={c.apertura.foto} sizes="(max-width: 1099px) 300px, 340px" loading="eager" />
          <span class="tacca-foto bs" aria-hidden="true"></span><span class="tacca-foto bd" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>
  <Sezione id="scrivi" numero={1} etichetta={c.scrivimi.etichetta} didascalia={c.scrivimi.didascalia}>
    <div class="contatti">
      <div data-rivela>
        <p class="hud faint">{imp.interfaccia.email}</p>
        <a class="email-grande" href={`mailto:${imp.email}`}>{imp.email}</a>
        <p class="testo contatti-nota">{c.scrivimi.nota}</p>
      </div>
      <div data-rivela style="--i:1">
        <h2 class="hud faint">{m.titolo}</h2>
        {chiave ? (
          <form class="modulo" action="https://api.web3forms.com/submit" method="POST" data-modulo data-inviato={m.inviato} data-errore={m.errore}>
            <input type="hidden" name="access_key" value={chiave} />
            <input type="hidden" name="subject" value={`${m.oggetto} · ${imp.nome}`} />
            <input type="checkbox" name="botcheck" class="campo-trappola" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label><span class="hud muted">{m.nome}</span><input name="name" autocomplete="name" required /></label>
            <label><span class="hud muted">{m.email}</span><input name="email" type="email" autocomplete="email" required /></label>
            <label><span class="hud muted">{m.messaggio}</span><textarea name="message" required></textarea></label>
            <div><button class="btn btn-pieno" type="submit"><Icona nome="invia" />{m.invia}</button></div>
            <p class="esito" role="status" aria-live="polite" data-esito></p>
          </form>
        ) : (
          <div class="modulo" data-senza-modulo>
            <p class="testo">{m.senza_chiave}</p>
            <div><Bottone href={`mailto:${imp.email}?subject=${encodeURIComponent(m.oggetto)}`} tipo="pieno" icona="posta">{m.bottone_email}</Bottone></div>
          </div>
        )}
      </div>
    </div>
  </Sezione>
  <Sezione id="canali" numero={2} etichetta={c.altri_canali.etichetta} didascalia={c.altri_canali.didascalia}>
    <CarteCanale voci={c.altri_canali.voci} />
  </Sezione>
</Base>
<style is:global>
  /* titolo e foto allineati al centro; dai 768 px la foto sta a destra del testo */
  .contatti-apertura { display: grid; align-items: center; }
  .contatti-testa { padding: var(--s-9) var(--margine) var(--s-7); }
  .contatti-testa .titolo-pagina { margin-top: 20px; }
  .contatti-testa .testo-grande { margin-top: var(--s-5); max-width: 40rem; }
  .contatti-foto { position: relative; width: min(70%, 300px); margin: 0 var(--margine) var(--s-8); border: 1px solid var(--line); }
  .contatti-foto .immagine { display: block; }
  @media (min-width: 768px) { .contatti-apertura { grid-template-columns: 1fr 260px; } .contatti-foto { width: auto; margin: var(--s-9) var(--margine) var(--s-8) 0; } }
  @media (min-width: 1100px) { .contatti-apertura { grid-template-columns: 1fr 340px; } }
  .contatti { display: grid; }
  .contatti > * { padding: var(--s-6) var(--margine); }
  .contatti > * + * { border-top: 1px solid var(--line); }
  .email-grande { display: inline-block; margin-top: var(--s-4); font-family: var(--font-display); font-weight: 620; font-stretch: 112%; font-size: 1.375rem; letter-spacing: -.02em; color: var(--ink-strong); overflow-wrap: anywhere; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 6px; transition: color .15s; }
  @media (hover: hover) { .email-grande:hover { color: var(--accent-ink); } }
  .contatti-nota { margin-top: var(--s-5); max-width: 30rem; }
  .modulo { display: grid; gap: 20px; margin-top: 20px; max-width: 34rem; }
  .modulo label { display: grid; gap: var(--s-2); }
  .modulo input, .modulo textarea { width: 100%; padding: var(--s-3) 14px; border: 1px solid var(--line-strong); border-radius: 0; background: var(--bg-sunken); color: var(--ink); font: inherit; }
  .modulo textarea { min-height: 160px; resize: vertical; }
  .modulo input:focus-visible, .modulo textarea:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 0; border-color: transparent; }
  .modulo .esito { min-height: 1.5em; color: var(--muted); }
  .campo-trappola { display: none; }
  @media (min-width: 768px) { .contatti > * { padding: var(--s-8) var(--margine); } .email-grande { font-size: 1.75rem; } }
  @media (min-width: 1100px) { .contatti { grid-template-columns: 1fr 1fr; } .contatti > * + * { border-top: 0; border-left: 1px solid var(--line); } }
</style>
