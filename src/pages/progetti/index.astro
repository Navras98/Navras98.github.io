---
// Elenco dei progetti, come la pagina «Craft Apps» di ArtCraft: titolo con le icone accanto, poi le quattro schede in fila.
import Base from '../../layouts/Base.astro';
import Sezione from '../../components/Sezione.astro';
import TestaPagina from '../../components/TestaPagina.astro';
import SchedaProgetto from '../../components/SchedaProgetto.astro';
import Immagine from '../../components/Immagine.astro';
import { pagina, progetti, spazio } from '../../lib/contenuti.js';
const pg = await pagina('progettiPagina');
const elenco = await progetti();
const indice = [{ id: 'hero', etichetta: pg.apertura.etichetta }, { id: 'elenco', etichetta: pg.elenco.etichetta }];
---
<Base seo={pg.seo} indice={indice}>
  <section id="hero" aria-labelledby="titolo-pagina">
    <div class="contenitore progetti-testa">
      <TestaPagina etichetta={pg.apertura.etichetta} titoloPagina={pg.apertura.titolo} testo={pg.apertura.testo} />
      <ul class="icone-progetti">
        {elenco.map((p, i) => (
          <li class={`c-${p.colore} entra`} style={`--e:${3 + i * 0.5}`}>
            <a href={`/progetti/${p.slug}/`}>
              <Immagine img={p.icona} decorativa class="icona-grande" sizes="112px" loading="eager" />
              <span class="icona-nome">{p.nome}{spazio(p.nome_colorato)}<span class="colore">{p.nome_colorato}</span></span>
              <span class="hud faint">{p.categoria}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Sezione id="elenco" numero={1} etichetta={pg.elenco.etichetta} didascalia={pg.elenco.didascalia}>
    <div class="griglia griglia-4">
      {elenco.map((p, i) => <SchedaProgetto p={p} i={i} livello={2} sizes="(max-width: 639px) 100vw, (max-width: 1099px) 50vw, 330px" />)}
    </div>
  </Sezione>
</Base>
<style is:global>
  .icone-progetti { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border-top: 1px solid var(--line); }
  .icone-progetti li { background: var(--bg); }
  .icone-progetti a { display: flex; flex-direction: column; align-items: center; gap: var(--s-3); padding: var(--s-6) var(--s-3); text-align: center; transition: background-color var(--rapido) linear; }
  @media (hover: hover) { .icone-progetti a:hover { background: var(--bg-raised); } }
  .icona-grande { width: 88px; height: 88px; border-radius: var(--raggio-icona); overflow: hidden; filter: var(--ombra-icona); transition: transform var(--medio) cubic-bezier(0, 0, .2, 1); }
  @media (hover: hover) { .icone-progetti a:hover .icona-grande { transform: translateY(-4px); } }
  .icona-nome { font-family: var(--font-display); font-weight: 620; font-stretch: 118%; font-size: 1rem; letter-spacing: -.02em; color: var(--ink-strong); overflow-wrap: anywhere; }
  @media (min-width: 640px) { .icona-nome { font-size: 1.25rem; } }
  .icona-nome .colore { color: var(--app-ink); }
  @media (min-width: 768px) and (max-width: 1099px) { .icone-progetti { grid-template-columns: repeat(4, 1fr); } .icone-progetti a { padding: var(--s-7) var(--s-2); } .icone-progetti .hud { white-space: nowrap; } }
  /* sopra i 1100 px le quattro icone stanno a destra del titolo, due per riga: niente doppione con le schede */
  @media (min-width: 1100px) {
    .progetti-testa { display: grid; grid-template-columns: 7fr 5fr; align-items: stretch; }
    .progetti-testa .icone-progetti { border-top: 0; border-left: 1px solid var(--line); align-content: stretch; }
    /* icone alla stessa quota anche quando un nome va su due righe */
    .progetti-testa .icone-progetti a { height: 100%; justify-content: flex-start; padding: var(--s-7) var(--s-2) var(--s-6); }
    .icona-grande { width: 96px; height: 96px; }
  }
</style>
